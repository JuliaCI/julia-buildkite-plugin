#!/usr/bin/env bash
set -euo pipefail
shopt -s extglob

source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"


## Set some global configuration options, but allow users to override them

## If we're running in debug mode, be REALLY VERBOSE:
if [[ "${BUILDKITE_PLUGIN_JULIA_DEBUG_PLUGIN:-false}" == "true" ]]; then
    PS4="> "
    set -x
fi

# Where Julia is downloaded and unpacked to, and where the depots live. The runner owns
# this directory: it keeps its size in check by deleting it between jobs, and gives
# concurrent jobs separate directories. See the README.
CACHE_DIR="$(jbp_cache_dir)"
echo "Cache directory: ${CACHE_DIR}"

# Options that configured the size-based pruning removed in v1.15.
for option in compiled_size_limit artifacts_size_limit depot_size_limit depot_age_limit pipeline_age_limit; do
    var="BUILDKITE_PLUGIN_JULIA_$(tr '[:lower:]' '[:upper:]' <<< "${option}")"
    if [[ -n "${!var+x}" ]]; then
        msg="The julia plugin option \`${option}\` has no effect since v1.15: the plugin no longer prunes its cache, the agent's runner does. See the plugin's README."
        echo "WARNING: ${msg}"
        buildkite-agent annotate --style warning --context "julia-plugin-${option}" "${msg}" || true
    fi
done

# Scratch space inside the cache, on the same filesystem, so that finished downloads and
# unpacks can be moved into place with an atomic rename. Entries left behind by jobs that
# were killed are removed once they are clearly not in use anymore.
TMP_ROOT="${CACHE_DIR}/tmp"
mkdir -p "${TMP_ROOT}"
find "${TMP_ROOT}" -mindepth 1 -maxdepth 1 -mmin +1440 \
    -exec chmod -R u+w {} + -exec rm -rf {} + 2>/dev/null || true
JOB_TMP="$(mktemp -d "${TMP_ROOT}/job.XXXXXXXX")"

# The version of Julia we're downloading
JULIA_VERSION="${BUILDKITE_PLUGIN_JULIA_VERSION:-1}"

# Did we get a julia version that's actually a URL?
if [[ "${JULIA_VERSION}" == "https://"* ]]; then
    CUSTOM_URL="${JULIA_VERSION#https://*}"
    JULIA_VERSION="<custom url>"
fi

# If the user has asked for an isolated depot, we will create one inside of `CACHE_DIR`
# that is specific to the current pipeline; use `PERSIST_DEPOT_DIRS` to keep some directories
# around between invocations; by default we persist content-addressed directories such as
# packages, artifacts and compiled `.ji` files
if [[ "${BUILDKITE_PLUGIN_JULIA_ISOLATED_DEPOT:-true}" == "true" ]]; then
    # Export `JULIA_DEPOT_PATH` so that future julia invocations use this depot. It comes
    # first; an inherited `JULIA_DEPOT_PATH` (e.g. a read-only store
    # provided by the runner) is kept after it. See `jbp_depot_path`.
    export DEPOT_DIR="${CACHE_DIR}/depots/${BUILDKITE_PIPELINE_ID}"
    if is_windows; then
        JULIA_DEPOT_PATH="$(jbp_depot_path ';' "$(cygpath -w "${DEPOT_DIR}")" \
                                           "${JULIA_DEPOT_PATH:-}" "${DEPOT_DIR}")"
    else
        JULIA_DEPOT_PATH="$(jbp_depot_path ':' "${DEPOT_DIR}" "${JULIA_DEPOT_PATH:-}")"
    fi
    export JULIA_DEPOT_PATH
    echo "JULIA_DEPOT_PATH: ${JULIA_DEPOT_PATH}"
    PERSIST_DEPOT_DIRS="$(echo ${BUILDKITE_PLUGIN_JULIA_PERSIST_DEPOT_DIRS:-packages,artifacts,compiled,logs,datadeps,scratchspaces} | tr ',' ' ' )"

    # Helper function to join a list of arguments by a particular character
    function join_by { local IFS="$1"; shift; echo "$*"; }

    # If the depot we're isolating ourselves inside of actually exists, we clean out
    # any directories not explicitly saved via `PERSIST_DEPOT_DIRS`
    if [[ -d "${DEPOT_DIR}" ]]; then
        echo "--- :broom: Cleaning out depot at ${DEPOT_DIR}, persisting: '${PERSIST_DEPOT_DIRS}'"
        pushd "${DEPOT_DIR}" >/dev/null
        rm -rf -- !($(join_by "|" ${PERSIST_DEPOT_DIRS}))
        popd >/dev/null

        # Clean out any stale pidfiles that may have come from a cancelled run. Should a
        # concurrent job be precompiling, losing its pidfile only costs duplicate work.
        if [[ -d "${DEPOT_DIR}"/compiled ]]; then
          find "${DEPOT_DIR}"/compiled -name '*.pidfile' -delete
        fi
    fi
else
    if [[ -n "${BUILDKITE_PLUGIN_JULIA_PERSIST_DEPOT_DIRS+x}" ]]; then
        buildkite-agent annotate --style warning "persist_depot_dirs specified with a non-isolated depot; this has no effect."
    fi
fi

# Look around to find the default download engine
# We prefer `curl` as it's more likely it's up to date and not some kind of
# busybox impostor, which `wget` is within our very own test suite!
#
# `download URL CACHED DEST` downloads URL to DEST unless CACHED is up to date. DEST is
# only created when there is something new, and gets the server's modification time, so
# that concurrent downloads of the same file are recognized as identical.
if [[ -n "$(which curl 2>/dev/null)" ]]; then
    download() {
        if [[ -f "$2" ]]; then
            curl -LfsR "$1" -o "$3" -z "$2"
        else
            curl -LfsR "$1" -o "$3"
        fi
    }
elif [[ -n "$(which wget 2>/dev/null)" ]]; then
    # wget's timestamping compares against a file at the destination, so give it a copy
    # of the cached file, and remove that copy again if nothing changed.
    download() {
        local dir file
        dir="$(mktemp -d "${JOB_TMP}/wget.XXXXXXXX")"
        file="${dir}/$(basename "$1")"
        [[ -f "$2" ]] && cp -p "$2" "${file}"
        wget -nv -NP "${dir}" "$1" || return 1
        if [[ -f "$2" && "$(stat_mtime "${file}")" == "$(stat_mtime "$2")" ]]; then
            rm -f "${file}"
        else
            mv "${file}" "$3"
        fi
    }
else
    buildkite-agent annotate --style error "No download agent available"
    exit 1
fi

if [[ "${OSTYPE}" == "darwin"* ]] || [[ "${OSTYPE}" == "freebsd"* ]]; then
    # BSD-style `stat` uses a different syntax than GNU-style
    stat_mtime() {
        stat -f "%m" "$@"
    }
else
    stat_mtime() {
        stat -c "%Y" "$@"
    }
fi

# Look around to find `python3`; if it doesn't exist, complain
if [[ -z "${BUILDKITE_PLUGIN_JULIA_PYTHON+x}" ]]; then
    if [[ -n "$(which python3 2>/dev/null)" ]]; then
        PYTHON="$(which python3)"
    elif [[ -n "$(which python 2>/dev/null)" ]] && [[ "$(python --version)" == "Python 3"* ]]; then
        PYTHON="$(which python)"
    fi
else
    PYTHON="$(which "${BUILDKITE_PLUGIN_JULIA_PYTHON}")"
fi

if [[ ! -x "${PYTHON:-}" ]]; then
    buildkite-agent annotate --style warning "No python 3 available!"
    exit 1
fi

# We allow the user to override the architecture we download
echo "--- :julia: Determining architecture"
echo "uname: $(uname -a)"
echo "User override: ${BUILDKITE_PLUGIN_JULIA_ARCH:-none}"
ARCH="${BUILDKITE_PLUGIN_JULIA_ARCH:-$(uname -m)}"

# Next, let's download Julia by calculating the URL we'll download from,
# then using `curl`/`wget`'s timestamping features to re-download if the
# source URL has updated its contents; if we end up downloading something
# we'll notice and re-extract by comparing timestamps of the file before
# and after download.
echo "--- :julia: Downloading Julia ${JULIA_VERSION} for arch ${ARCH}"

# Calculate the download URL, unless the user is asking for a custom URL:
if [[ "$OSTYPE" == "linux-gnu"* ]]; then
    os="linux"
    nightly_os="linux"
    case "$ARCH" in
      "x86_64")
        larch="x64"
        rosarch="linux-x86_64"
        nightly_larch="x86_64"
        nightly_rosarch="linux-x86_64"
        ;;
      "i686")
        larch="x86"
        rosarch="linux-i686"
        nightly_larch="i686"
        nightly_rosarch="linux-i686"
        ;;
      "aarch64")
        larch="aarch64"
        rosarch="linux-aarch64"
        nightly_larch="aarch64"
        nightly_rosarch="linux-aarch64"
        ;;
      "armv7l")
        larch="armv7l"
        rosarch="linux-armv7l"
        nightly_rosarch="linuxarmv7l"
        ;;
      "powerpc64le"|"ppc64le")
        larch="ppc64le"
        rosarch="linux-ppc64le"
        nightly_larch="powerpc64le"
        nightly_rosarch="linux-powerpc64le"
        ;;
      *)
        buildkite-agent annotate --style error "Unhandled OS $OSTYPE/arch $ARCH combo"
        exit 1
        ;;
    esac
    ext="tar.gz"
elif [[ "$OSTYPE" == "linux-musl"* ]]; then
    os="musl"
    nightly_os="musl"
    case "$ARCH" in
      "x86_64")
        larch="x64"
        rosarch="musl-x86_64"
        nightly_larch="x86_64"
        nightly_rosarch="musl-x86_64"
        ;;
      *)
        buildkite-agent annotate --style error "Unhandled OS $OSTYPE/arch $ARCH combo"
        exit 1
        ;;
    esac
    ext="tar.gz"
elif [[ "$OSTYPE" == "darwin"* ]]; then
    os="mac"
    nightly_os="macos"
    case "$ARCH" in
      "x86_64")
        larch="x64"
        rosarch="mac64"
        nightly_larch="x86_64"
        nightly_rosarch="macos-x86_64"
        ;;
      "arm64" | "aarch64")
        larch="aarch64"
        rosarch="macaarch64"
        nightly_larch="aarch64"
        nightly_rosarch="macos-aarch64"
        ;;
      *)
        buildkite-agent annotate --style error "Unhandled OS $OSTYPE/arch $ARCH combo"
        exit 1
        ;;
    esac
    ext="tar.gz"
elif is_windows; then
    os="winnt"
    nightly_os="winnt"
    case "$ARCH" in
      "x86_64")
        larch="x64"
        rosarch="win64"
        nightly_larch="x64"
        nightly_rosarch="win64"
        ;;
      "i686")
        larch="x86"
        rosarch="win32"
        nightly_larch="x86"
        nightly_rosarch="win32"
        ;;
      *)
        buildkite-agent annotate --style error "Unhandled OS $OSTYPE/arch $ARCH combo"
        exit 1
        ;;
    esac
    ext="zip"
else
    buildkite-agent annotate --style error "Unhandled OS $OSTYPE"
    exit 1
fi

path="bin/$os/$larch"
if [[ -n "${CUSTOM_URL:-}" ]]; then
    echo "Overriding version selection, using custom URL '${CUSTOM_URL}'"

    # Parse `CUSTOM_URL` into `bucket_host` and `path` pieces, trimming `${ext}` off the end.
    bucket_host="${CUSTOM_URL%%/*}"
    path="${CUSTOM_URL#*/}"
    path="${path%%.${ext}}"
elif [[ "$JULIA_VERSION" == "nightly" ]]; then        # `version: 'nightly'`
    bucket_host="julialangnightlies-s3.julialang.org"
    path="bin/$nightly_os/$nightly_larch/julia-latest-$nightly_rosarch"
elif [[ "$JULIA_VERSION" =~ ^(.+)-nightly$ ]]; then # for example, `version: '1.6-nightly'`
    bucket_host="julialangnightlies-s3.julialang.org"
    release="${BASH_REMATCH[1]}"
    path="bin/$nightly_os/$nightly_larch/$release/julia-latest-$nightly_rosarch"
else
    bucket_host="julialang-s3.julialang.org"
    if [[ $JULIA_VERSION =~ ^([0-9]+|alpha|beta|rc)$ ]]; then
        # for example, `version: '1'` or `version: 'rc'`, which we resolve using versions.json
        if ! release="$("${PYTHON}" "$(dirname "${BASH_SOURCE[0]}")/resolve_version.py" "${JULIA_VERSION}")"; then
            buildkite-agent annotate --style error "Could not resolve Julia version $JULIA_VERSION"
            exit 1
        fi
    elif [[ $JULIA_VERSION =~ ^[0-9]+\.[0-9]+(\.[0-9]+(-(alpha|beta|rc)[0-9]+)?)?$ ]]; then
        release="${JULIA_VERSION}"                  # for example, `version: '1.6'`, `'1.6.7'` or `'1.13.0-rc1'`
    else
        buildkite-agent annotate --style error "Unsupported version $JULIA_VERSION"
        exit 1
    fi
    # Minor versions download their latest patch release, which has `-latest` in its URL
    postfix=""
    if [[ $release =~ ^[0-9]+\.[0-9]+$ ]]; then
        postfix="-latest"
    fi
    short_release="$(cut -d '.' -f 1,2 <<< "$release")"
    path="$path/$short_release/julia-$release$postfix-$rosarch"
fi
url="https://$bucket_host/$path.$ext"

# Download Julia to our cache directory. If the archive is already there, this may take
# only a few hundred milliseconds, as it checks the timestamp of the file on the remote
# server and compares it against the local one.
#
# Nothing is written in place, so that a job killed halfway leaves nothing broken
# behind: downloads and unpacks happen in `JOB_TMP` and are renamed into place once
# complete. Installations are immutable: each one lives in a directory named after the
# modification time of its archive, `INSTALLS/<stamp>`, and contains `INSTALL_STAMP`
# once complete. A newer archive gets a new directory; superseded ones are left for the
# runner's eviction.
echo "Source URL: $url"
archive_path="${CACHE_DIR}/downloads/$path.$ext"
INSTALLS="${CACHE_DIR}/installs/$path"
INSTALL_STAMP=".julia-buildkite-plugin-complete"

# `rename_dir SRC DST`: an atomic rename that fails if DST is a non-empty directory,
# unlike plain `mv`, which would move SRC into it. BSD `mv` lacks `-T`.
if mv --version >/dev/null 2>&1; then
    rename_dir() { mv -T "$1" "$2"; }
else
    rename_dir() { "${PYTHON}" -c 'import os, sys; os.rename(sys.argv[1], sys.argv[2])' "$1" "$2"; }
fi

# `is_installed DIR`: whether DIR is a complete installation.
is_installed() {
    [[ -f "$1/${INSTALL_STAMP}" ]] && [[ -e "$1/bin/julia" || -e "$1/bin/julia.exe" ]]
}

# `unpack ARCHIVE`: make sure `INSTALLS/<stamp of ARCHIVE>` is installed, and set
# `unpack_dest` to it.
unpack() {
    local archive="$1" staging
    unpack_dest="${INSTALLS}/$(stat_mtime "${archive}")"
    is_installed "${unpack_dest}" && return 0

    echo "New or updated installation detected, unpacking!"
    staging="$(mktemp -d "${JOB_TMP}/install.XXXXXXXX")"
    if [[ "${archive}" == *.tar.gz ]]; then
        tar -xof "${archive}" --strip-components=1 -C "${staging}" || return 1
    elif [[ "${archive}" == *.zip ]]; then
        unzip -q "${archive}" -d "${staging}" || return 1
        mv "${staging}"/julia-*/* "${staging}" || return 1
        rmdir "${staging}"/julia-* || return 1
    else
        buildkite-agent annotate --style error "Unhandled archive type ${archive}"
        exit 1
    fi
    touch "${staging}/${INSTALL_STAMP}"
    is_installed "${staging}" || return 1

    # An incomplete installation (e.g. its stamp survived a partial deletion) is moved
    # aside. If a concurrent job publishes the same archive first, its copy is used.
    if [[ -e "${unpack_dest}" ]] && ! is_installed "${unpack_dest}"; then
        rename_dir "${unpack_dest}" "$(mktemp -d "${JOB_TMP}/broken.XXXXXXXX")/install" \
            2>/dev/null || true
    fi
    mkdir -p "${INSTALLS}"
    rename_dir "${staging}" "${unpack_dest}" 2>/dev/null || true
    is_installed "${unpack_dest}"
}

mkdir -p "$(dirname "${archive_path}")"
new_archive="${JOB_TMP}/archive.${ext}"
download "${url}" "${archive_path}" "${new_archive}"
if [[ -s "${new_archive}" ]]; then
    unpack "${new_archive}"
    mv -f "${new_archive}" "${archive_path}"
elif ! unpack "${archive_path}"; then
    # The cached archive may be truncated (v1.14 and older downloaded in place); fetch it again.
    echo "Unpacking the cached archive failed, downloading it again"
    rm -f "${archive_path}"
    download "${url}" "${archive_path}" "${new_archive}"
    unpack "${new_archive}"
    mv -f "${new_archive}" "${archive_path}"
fi
echo "Installed location: ${unpack_dest}"

# Show that julia is installed and print out the version info
echo "--- :julia: Installation Successful"
echo "Julia ${JULIA_VERSION} successfully installed to ${unpack_dest}"
"${unpack_dest}/bin/julia" -e 'using InteractiveUtils; versioninfo()'

# Update the registry
if [[ "${BUILDKITE_PLUGIN_JULIA_UPDATE_REGISTRY:-true}" == "true" ]]; then
    echo "--- :julia: Updating the registry"

    "${unpack_dest}/bin/julia" -e '
      using Pkg
      if VERSION >= v"1.1-"
        if !isdir(joinpath(DEPOT_PATH[1], "registries", "General"))
          Pkg.Registry.add("General")
        else
          Pkg.Registry.update()
        end
      else
        Pkg.API.update_registry(Pkg.Types.Context())
      end'
fi

# Done with our scratch space. This must happen before `PATH` is converted for Windows,
# after which bash can no longer find `chmod` and `rm`.
chmod -R u+w "${JOB_TMP}" 2>/dev/null || true
rm -rf "${JOB_TMP}"

if ! is_windows; then
    # Export `PATH` such that this `julia` is the first one other plugins find
    export PATH=${unpack_dest}/bin:"$PATH"
else
    # buildkite/agent#872: PATH gets corrupted on Windows
    # So we pass each element of `$PATH` through `cygpath -w`
    MSYS_PATH="$(cygpath -w ${unpack_dest}/bin)"
    IFS=':'
    for p in $PATH ; do
        MSYS_PATH="${MSYS_PATH};$(cygpath -w $p)"
    done
    export PATH="${MSYS_PATH}"
fi

# The pre-exit hook removes coverage files from this installation.
export JULIA_BUILDKITE_PLUGIN_INSTALL_DIR="${unpack_dest}"

export BUILDKITE_PLUGIN_JULIA_SUCCESS="true"
